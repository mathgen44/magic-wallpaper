{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Background",
  "version": "0.2.0",
  "identifier": "com.mathgen44.dynamicbackground",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mathgen44",
    "copyright": "© mathgen44 — MIT",
    "category": "Utility",
    "shortDescription": "Fond d'écran dynamique modulaire",
    "longDescription": "Construisez votre fond d'écran Windows avec des briques : carrousel d'images, flux RSS, informations système, horloge…",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
